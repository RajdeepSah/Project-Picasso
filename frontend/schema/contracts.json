{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "CapabilitiesResponse": {
      "additionalProperties": false,
      "properties": {
        "ai": {
          "$ref": "#/$defs/Capability"
        },
        "dashboard": {
          "$ref": "#/$defs/Capability"
        },
        "gcode_export": {
          "$ref": "#/$defs/Capability"
        },
        "generation": {
          "$ref": "#/$defs/Capability"
        },
        "history": {
          "$ref": "#/$defs/Capability"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sd_export": {
          "$ref": "#/$defs/Capability"
        },
        "serial_control": {
          "$ref": "#/$defs/Capability"
        },
        "voice": {
          "$ref": "#/$defs/Capability"
        }
      },
      "required": [
        "dashboard",
        "generation",
        "history",
        "gcode_export",
        "sd_export",
        "serial_control",
        "ai",
        "voice"
      ],
      "title": "CapabilitiesResponse",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "phase": {
          "title": "Phase",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "available",
        "phase",
        "reason"
      ],
      "title": "Capability",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "properties": {
        "height_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Height Mm",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Width Mm",
          "type": "number"
        }
      },
      "required": [
        "width_mm",
        "height_mm"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "DrawingSpec": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "standard",
          "enum": [
            "sparse",
            "standard",
            "dense"
          ],
          "title": "Detail",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "generator": {
          "enum": [
            "circle",
            "rectangle",
            "spiral",
            "butterfly",
            "mandala",
            "pattern"
          ],
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "default": "1",
          "maxLength": 40,
          "minLength": 1,
          "title": "Generator Version",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/GeneratorParameters"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "generator",
        "dimensions"
      ],
      "title": "DrawingSpec",
      "type": "object"
    },
    "GenerateRequest": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "GenerateRequest",
      "type": "object"
    },
    "GeneratorParameters": {
      "additionalProperties": false,
      "properties": {
        "petals": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 3,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Petals"
        },
        "radius_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 2000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius Mm"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "symmetry": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symmetry"
        },
        "turns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turns"
        }
      },
      "title": "GeneratorParameters",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "const": "project-picasso",
          "default": "project-picasso",
          "title": "Application",
          "type": "string"
        },
        "frontend_ready": {
          "title": "Frontend Ready",
          "type": "boolean"
        },
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "phase": {
          "const": 2,
          "default": 2,
          "title": "Phase",
          "type": "integer"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "const": "ready",
          "default": "ready",
          "title": "Status",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
