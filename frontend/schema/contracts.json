  "anyOf": [
    {
      "$ref": "#/$defs/DrawingSpec"
    },
    {
      "$ref": "#/$defs/PolylineDrawing"
    },
    {
      "$ref": "#/$defs/ProfilesResponse"
    },
    {
      "$ref": "#/$defs/CapabilitiesResponse"
    },
    {
      "$ref": "#/$defs/HealthResponse"
    },
    {
      "$ref": "#/$defs/StudioStatus"
    },
    {
      "$ref": "#/$defs/ApiError"
    },
    {
      "$ref": "#/$defs/GenerateRequest"
    }
  ],
  "title": "PicassoContracts"
}
