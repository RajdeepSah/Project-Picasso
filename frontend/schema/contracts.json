      "required": [
        "version",
        "instance_id",
        "frontend_ready",
        "python_version"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "MachineProfile": {
      "additionalProperties": false,
      "properties": {
        "allowed_region": {
          "default": null,
          "title": "Allowed Region",
          "type": "null"
        },
        "anchor_y_mm": {
          "title": "Anchor Y Mm",
          "type": "number"
        },
        "board": {
          "default": null,
          "title": "Board",
          "type": "null"
        },
        "dialect": {
          "const": "picasso-legacy-v1",
          "default": "picasso-legacy-v1",
