        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage": {
          "$ref": "#/$defs/StorageStatus"
        }
      },
      "required": [
        "machine",
        "storage"
      ],
      "title": "StudioStatus",
      "type": "object"
    }
