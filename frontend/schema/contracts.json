          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/DrawingSpec"
        },
        "strokes": {
          "items": {
            "$ref": "#/$defs/Stroke"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Strokes",
          "type": "array"
        },
        "units": {
          "const": "mm",
          "default": "mm",
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "source",
        "strokes"
      ],
      "title": "PolylineDrawing",
      "type": "object"
    },
    "ProfilesResponse": {
      "additionalProperties": false,
      "properties": {
        "active_profile_id": {
          "default": null,
          "title": "Active Profile Id",
          "type": "null"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/MachineProfile"
          },
          "title": "Profiles",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "profiles"
      ],
      "title": "ProfilesResponse",
      "type": "object"
    },
    "StorageStatus": {
      "additionalProperties": false,
      "properties": {
        "discovery_performed": {
          "const": false,
          "default": false,
          "title": "Discovery Performed",
          "type": "boolean"
        },
        "local_mirror": {
          "const": "SdCard",
          "default": "SdCard",
          "title": "Local Mirror",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "const": "not_configured",
          "default": "not_configured",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "StorageStatus",
      "type": "object"
    },
    "Stroke": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "default": false,
          "title": "Closed",
          "type": "boolean"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 100000,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "points"
      ],
      "title": "Stroke",
      "type": "object"
    },
    "StudioStatus": {
      "additionalProperties": false,
      "properties": {
        "credentials_required": {
          "const": false,
          "default": false,
          "title": "Credentials Required",
          "type": "boolean"
