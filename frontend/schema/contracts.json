          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "pen_down_degrees": {
          "maximum": 180,
          "minimum": 0,
          "title": "Pen Down Degrees",
          "type": "integer"
        },
        "pen_up_degrees": {
          "maximum": 180,
          "minimum": 0,
          "title": "Pen Up Degrees",
          "type": "integer"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "separation_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Separation Mm",
          "type": "number"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "spool_diameter_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "title": "Spool Diameter Mm",
          "type": "number"
        },
        "steps_per_turn": {
          "exclusiveMinimum": 0,
          "title": "Steps Per Turn",
          "type": "integer"
        },
        "verified": {
          "const": false,
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "label",
        "source_path",
        "separation_mm",
        "anchor_y_mm",
        "spool_diameter_mm",
        "steps_per_turn",
        "pen_up_degrees",
        "pen_down_degrees",
        "notes"
      ],
      "title": "MachineProfile",
      "type": "object"
    },
    "MachineStatus": {
      "additionalProperties": false,
      "properties": {
        "discovery_performed": {
          "const": false,
          "default": false,
          "title": "Discovery Performed",
          "type": "boolean"
        },
        "position_known": {
          "const": false,
          "default": false,
          "title": "Position Known",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "MachineStatus",
      "type": "object"
    },
    "PolylineDrawing": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "centered_cartesian_y_up",
          "default": "centered_cartesian_y_up",
