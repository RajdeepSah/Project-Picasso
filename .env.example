# Copy to .env (git-ignored) to enable optional AI drawings. Offline shapes never need this.
# Requests the offline grammar cannot draw are sent to the OpenAI Image API and billed to this key.
# The key is read only by the local backend; it is never sent to the browser or saved in history.
OPENAI_API_KEY=

# Optional: a different OpenAI image model (default gpt-image-2.5-flare, the fast everyday model).
# PICASSO_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional: turn AI drawing off entirely, even with a key present.
# PICASSO_AI=off
